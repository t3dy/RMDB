{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "interpretive",
  "title": "InterpretiveArtifact",
  "description": "Makes bounded scholarly interpretations from prior descriptive and tagging artifacts. Every interpretive claim must have evidence_links or be marked speculative. Stage E of the artifact pipeline.",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "source_id",
    "generated_at",
    "input_artifact_ids",
    "interpretive_claims"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_id":         { "type": "string", "minLength": 1 },
    "artifact_type":       { "type": "string", "const": "interpretive" },
    "schema_version":      { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "source_id":           { "type": "string", "minLength": 1 },
    "generated_at":        { "type": "string", "format": "date-time" },
    "generated_by":        { "type": ["string", "null"] },
    "input_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "artifact_ids of RawExtractionArtifact and/or OntologyTaggingArtifact consumed"
    },
    "interpretive_questions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Scholarly questions this artifact addresses"
    },
    "interpretive_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "confidence"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "evidence_links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["artifact_id", "location"],
              "additionalProperties": false,
              "properties": {
                "artifact_id": { "type": "string" },
                "location":    { "type": "string", "description": "page, passage excerpt, section_id, etc." },
                "quote":       { "type": ["string", "null"] }
              }
            },
            "description": "Required unless speculative is true"
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "speculative"]
          },
          "speculative": {
            "type": "boolean",
            "description": "Must be true if evidence_links is empty"
          },
          "alternative_readings": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "historiographical_relevance": {
      "type": ["string", "null"],
      "description": "How this relates to historiographical debates (Yates thesis, Copenhaver revision, etc.)"
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "What this interpretation cannot establish or where evidence is thin"
    },
    "interpretation_notes": { "type": ["string", "null"] }
  }
}
